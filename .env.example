# Copy to .env and fill in. NEVER commit/share the real file.
# Base58 private key — Phantom: Settings > Security > Export Private Key
SOL_PRIVATE_KEY=

# Optional (defaults shown). Public RPC works but a free Helius key is much faster:
# RPC_URL=https://api.mainnet-beta.solana.com
# SLIPPAGE_BPS=300
# MAX_PRIORITY_LAMPORTS=2000000    # FAST fee mode cap (also the sniper's PumpPortal priorityFee)
# JITO_TIP_LAMPORTS=0              # 0 = dynamic (live tip floor); or fix e.g. 10000
# PORT=5010

# --- read rotation (2026-08-08) ---
# Extra PRIVATE endpoints, comma separated. RPC_URL above stays the primary and
# is the only one sends start on; these only take READ traffic (confirm polls,
# holdings scans, keepalive), round-robin, so one key stops eating every request.
# Public mainnet-beta is never in the rotation — it stays the last resort.
# RPC_URLS=https://your-second-key.example/?api-key=...,https://your-third.example/?api-key=...
# RPC_COOLDOWN_S=20                # bench an endpoint this long after a 429/timeout

# --- ECO fee mode (cheapest sells) ---
# Separate from MAX_PRIORITY_LAMPORTS on purpose: that constant is also the live
# sniper's PumpPortal priorityFee, so lowering it to get cheap sells would
# under-fee snipes.
# ECO_PRIORITY_LAMPORTS=50000      # 0.00005 SOL ceiling
# ECO_PRIORITY_LEVEL=medium        # medium | high | veryHigh
